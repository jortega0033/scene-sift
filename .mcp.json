{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "exec",
        "chrome-devtools-mcp",
        "--isolated",
        "--viewport",
        "1440x900",
        "--allowedUrlPattern",
        "http://127.0.0.1:*",
        "--allowedUrlPattern",
        "http://localhost:*",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "exec",
        "playwright-mcp",
        "--browser",
        "chrome",
        "--isolated",
        "--host",
        "127.0.0.1",
        "--port",
        "3123",
        "--allowed-hosts",
        "127.0.0.1",
        "localhost",
        "--allowed-origins",
        "http://127.0.0.1:4173;http://localhost:4173",
        "--output-mode",
        "file",
        "--output-dir",
        ".qa/playwright-mcp-output",
        "--viewport-size",
        "1440x900",
        "--block-service-workers"
      ]
    }
  }
}
