{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm dev*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:watch*)",
      "Bash(pnpm test:e2e*)",
      "Bash(pnpm test:visual*)",
      "Bash(pnpm test:electron*)",
      "Bash(pnpm test:qa*)",
      "Bash(pnpm governance:validate*)",
      "Bash(pnpm governance:scenarios*)",
      "Bash(pnpm architecture:validate*)",
      "Bash(pnpm design:validate*)",
      "Bash(pnpm dependencies:validate*)",
      "Bash(pnpm validate*)",
      "Bash(pnpm build*)",
      "Bash(pnpm clean*)",
      "Bash(pnpm format*)",
      "Bash(pnpm baseline:generate*)",
      "Bash(pnpm security:scan*)",
      "Bash(pnpm package:dir*)",
      "Bash(pnpm qa:serve*)",
      "Bash(pnpm claude:validate*)",
      "Bash(pnpm claude:doctor*)",
      "Bash(pnpm claude:safe*)",
      "Bash(pnpm claude:test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git stash list*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git remote -v*)",
      "Bash(ls*)",
      "Bash(find . *)",
      "Bash(cat package.json*)",
      "Bash(node --version*)",
      "Bash(pnpm --version*)",
      "Bash(claude --version*)",
      "Bash(claude doctor*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list*)",
      "Bash(git fetch*)",
      "Bash(git push -u origin ticket/*)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create --draft *)",
      "Bash(gh pr ready *)",
      "Bash(gh run view *)",
      "Bash(node .claude/hooks/role-gate.mjs --self-test)",
      "Bash(python .claude/skills/ui-ux-pro-max/scripts/search.py *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * +*)",
      "Bash(git push --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:refs/heads/main*)",
      "Bash(git push origin :*)",
      "Bash(git push *:*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * --all*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --tags*)",
      "Bash(git push * --follow-tags*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- *)",
      "Bash(git stash drop*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(pnpm add -g*)",
      "Bash(npm install -g*)",
      "Bash(electron-builder --publish*)",
      "Bash(firebase deploy*)",
      "Bash(vercel deploy*)",
      "Bash(rm -rf*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(curl*| sh*)",
      "Bash(wget*| sh*)",
      "Bash(cat .env*)",
      "Bash(cat .env.*)",
      "Bash(printenv *SECRET*)",
      "Bash(printenv *KEY*)",
      "Bash(printenv *TOKEN*)",
      "Bash(echo $*SECRET*)",
      "Bash(echo $*KEY*)",
      "Bash(echo $*TOKEN*)",
      "Bash(*--dangerously-skip-permissions*)",
      "Bash(gh repo delete*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "PowerShell(git push*)",
      "PowerShell(git merge*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr ready*)",
      "PowerShell(gh release*)",
      "PowerShell(gh repo delete*)"
    ],
    "ask": [
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/rules/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/agency-agents/**)",
      "Edit(/.github/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/AGENTS.md)",
      "Edit(/LOOP.md)",
      "Edit(/loop-constraints.md)",
      "Edit(/loop-budget.md)",
      "Edit(/gate.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-file-write.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-bash-command.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/role-gate.mjs",
              "check"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validate-config-change.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-validation.mjs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/record-agent-event.mjs"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/role-gate.mjs",
              "record"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 30
}
