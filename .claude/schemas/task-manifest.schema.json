{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task-manifest",
  "title": "Task Manifest",
  "description": "Structured task declaration for governed-task pipeline",
  "type": "object",
  "required": ["task", "riskLevel", "targetPaths", "agent"],
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "string",
      "minLength": 10,
      "description": "Clear description of what to implement"
    },
    "riskLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "Risk level per gate.yaml classification"
    },
    "targetPaths": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Files or glob patterns to be modified"
    },
    "agent": {
      "type": "string",
      "description": "Agent name responsible for implementation"
    },
    "verifier": {
      "type": "string",
      "description": "Agent name responsible for independent verification (required for risk 2+)"
    },
    "humanApproval": {
      "type": "boolean",
      "description": "Whether explicit human approval was obtained (required for risk 3+)"
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 3
    },
    "evidence": {
      "$ref": "evidence.schema.json"
    }
  }
}
